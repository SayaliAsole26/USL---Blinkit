# Backend (local / Railway)
DATABASE_URL=postgresql://usl:usl@localhost:5432/usl
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=mixtral-8x7b-32768
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=dev-secret-change-in-production

# Feature flags
USL_ENABLED=true
USL_CHECKOUT_RECOMMENDATIONS=true
DISMISS_COOLDOWN_DAYS=7

# Phase 2 — Path A intent processing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_ENABLED=true
MATCH_CONFIDENCE_THRESHOLD=0.45
MAX_CATALOG_SHORTLIST=80
MAX_CATALOG_MATCHES=3
INTENT_WORKER_SYNC=false
ADMIN_DEBUG_ENABLED=true

# Frontend (Vercel / local)
VITE_API_URL=http://localhost:8000
VITE_ADMIN_DEBUG=true
