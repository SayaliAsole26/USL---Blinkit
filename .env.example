# =============================================================================
# Local development (copy to .env at repo root)
# =============================================================================

# Backend
DATABASE_URL=postgresql://usl:usl@127.0.0.1:5433/usl
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey
MEILI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=mixtral-8x7b-32768
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_VERCEL_PREVIEWS=true
JWT_SECRET=dev-secret-change-in-production
ENVIRONMENT=development

# Feature flags
USL_ENABLED=true
USL_CHECKOUT_RECOMMENDATIONS=true
DISMISS_COOLDOWN_DAYS=7
EVENT_WINDOW_DAYS=14
REPLENISHMENT_DUE_THRESHOLD=1.0
FREQUENCY_CAP_DAYS=7
WEATHER_CACHE_TTL_SECONDS=86400
CONTEXT_CACHE_TTL_SECONDS=300

# Phase 6 — production hardening
CHECKOUT_CACHE_TTL_SECONDS=300
EXPLANATION_CACHE_TTL_SECONDS=86400
ROLLOUT_PERCENTAGE=100

# Phase 7 — experiments & availability watch
EXPERIMENTS_ENABLED=true

# Phase 2 — Path A intent processing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_ENABLED=true
MATCH_CONFIDENCE_THRESHOLD=0.45
MAX_CATALOG_SHORTLIST=80
MAX_CATALOG_MATCHES=3
INTENT_WORKER_SYNC=false
ADMIN_DEBUG_ENABLED=true

# Startup hooks (Railway first deploy — set on API service, then disable)
RUN_MIGRATIONS_ON_STARTUP=false
SEED_CATALOG_ON_STARTUP=false

# Frontend (Vercel / local)
VITE_API_URL=http://localhost:8000
VITE_ADMIN_DEBUG=true

# =============================================================================
# Railway (API + worker) — set in Railway dashboard / shared variables
# =============================================================================
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# GROQ_API_KEY=gsk_...
# JWT_SECRET=<strong-random-secret>
# CORS_ORIGINS=https://your-app.vercel.app
# CORS_ALLOW_VERCEL_PREVIEWS=true
# ENVIRONMENT=production
# INTENT_WORKER_SYNC=false
# ADMIN_DEBUG_ENABLED=false
# MEILI_ENABLED=false
# RUN_MIGRATIONS_ON_STARTUP=true   # first deploy only — requires pgvector Postgres
# SEED_CATALOG_ON_STARTUP=true     # first deploy only — then set both back to false
# EMBEDDINGS_ENABLED=false         # recommended on API (worker can enable)
# MEILI_ENABLED=false
# If healthcheck fails: link DATABASE_URL + REDIS_URL, redeploy; check Deploy Logs for migration errors
# Worker start command: /app/start-worker.sh

# =============================================================================
# Vercel (frontend) — Project → Settings → Environment Variables
# =============================================================================
# VITE_API_URL=https://your-api.up.railway.app
# VITE_ADMIN_DEBUG=false
